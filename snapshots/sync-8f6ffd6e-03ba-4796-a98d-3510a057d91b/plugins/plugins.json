      "lineId": "mnemon",
      "raw": {
        "id": "mnemon",
        "name": "dsh-mnemon",
        "config": {
          "remoteAccess": "read-only",
          "timeoutMs": 10000,
          "defaultRecallLimit": 10,
          "embedding": {
            "enabled": true,
            "endpoint": "http://api.yangtzeu.edu.cn/v1",
            "model": "Qwen3-embedding-8B",
            "protocol": "openai",
            "apiKey": ""
          },
          "recallQuality": {
            "policy": "strict-v1",
            "lowScoreThreshold": 0.25,
            "highScoreThreshold": 0.6,
            "candidateMultiplier": 3,
            "maxMediumResults": 4,
            "maxUnknownResults": 2
          },
          "routingGuidance": true,
          "tabEnabled": true,
          "writeEnabled": true,
          "lifecycleEnabled": true,
          "recallMode": "guided",
          "writebackMode": "guided",
          "idleReviewMs": 30000
        }
      }
    },
    {
      "file": "profiles/desktop/cordis.patch.yml",
