      "raw": {
        "id": "auto-continue",
        "name": "dsh-client-auto-continue",
        "config": {
          "continueText": "继续完成原任务，从中断处接着处理；先确认上一步状态，避免重复已完成的操作和内容。",
          "continueTextMaxTokens": "",
          "graceMs": 5000,
          "cooldownMs": 30000,
          "scanLimit": 3
        }
      }
    },
